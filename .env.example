# --- Required ---

# Address of the machine running homebridge-melcloud-control's RESTful server.
HOMEBRIDGE_ADDRESS=192.168.1.999

# Devices to monitor. Either use the generic list (label:port,label:port ...):
#   MONITOR_DEVICES=downstairs:9567,upstairs:9568
# ...or the legacy per-device ports below. Port = last 4 digits of the device id
# (with a leading 0 swapped to 9 to avoid reserved ports < 1024, e.g. 0567 -> 9567).
# ports originate from the MELCloud device ID (last 4 digits with above caveat)
DOWNSTAIRS_PORT=9567
UPSTAIRS_PORT=9568

# --- Optional (defaults shown) ---

# Which auto-dry behaviour(s) to run: post-off | periodic | both
DRY_STRATEGY=both

# How long to run FAN mode to dry the unit out (milliseconds). Default 15 min.
FAN_DRY_DURATION_MS=900000

# For the 'periodic' strategy: hours of continuous COOL/DRY before forcing a dry cycle.
MAX_COOL_RUN_HOURS=2

# How often to poll each device (milliseconds).
POLL_INTERVAL_MS=60000

# Fixed fan speed during the dry cycle (0=Auto, 1-6). Leave unset to not touch fan speed.
# FAN_SPEED=0

# When true, log the actions that would be taken but never POST to the device.
DRY_RUN=false
